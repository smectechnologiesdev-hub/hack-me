# ===========================================================================
# Brute-Force Authentication Training Lab — Environment configuration
#
# Copy this file to ".env" and fill in the values.  NEVER commit the real
# ".env" file.  In production every secret below MUST be set explicitly.
# ===========================================================================

# --- Core Django -----------------------------------------------------------
# Generate one with:  python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me-to-a-long-random-string

# "True" only for local development.  MUST be "False" in production.
DEBUG=True

# Comma-separated list of hostnames the site may serve.
# Example (production): mylab.example.com,www.mylab.example.com
ALLOWED_HOSTS=127.0.0.1,localhost

# Comma-separated list of trusted origins for CSRF (scheme required).
# Example (production): https://mylab.example.com
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Which settings module to load: config.settings.dev | config.settings.prod
DJANGO_SETTINGS_MODULE=config.settings.dev

# --- Database --------------------------------------------------------------
# Leave blank for local SQLite (db.sqlite3).
# For PostgreSQL use e.g.:
#   postgres://lab_user:lab_password@127.0.0.1:5432/lab_db
DATABASE_URL=

# --- Redis / Channels ------------------------------------------------------
# If set, Channels uses Redis for the WebSocket layer (required in production
# with more than one worker).  If blank, an in-memory layer is used, which is
# fine for single-process local development only.
REDIS_URL=

# --- Lab defaults (optional overrides) -------------------------------------
# Default maximum password attempts per lab before it locks.
LAB_MAX_ATTEMPTS=100
# Default lab lifetime in minutes before it expires.
LAB_DURATION_MINUTES=60

# --- Educational display ---------------------------------------------------
# If "True", candidate passwords are shown in full (masked otherwise) inside
# the student's OWN isolated lab dashboard.  They are always clearly labelled
# as training data and are never exposed across labs.
SHOW_FULL_CANDIDATE_PASSWORDS=False
