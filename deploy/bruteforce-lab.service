# ===========================================================================
# systemd unit for the Brute-Force Authentication Lab (Daphne ASGI server).
# Install at /etc/systemd/system/bruteforce-lab.service, then:
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now bruteforce-lab
# ===========================================================================
[Unit]
Description=Brute-Force Authentication Lab (Daphne ASGI)
After=network.target postgresql.service redis-server.service
Wants=redis-server.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/bruteforce-lab
# All secrets come from the environment file (chmod 600, owned by ubuntu).
EnvironmentFile=/home/ubuntu/bruteforce-lab/.env
Environment=DJANGO_SETTINGS_MODULE=config.settings.prod
ExecStart=/home/ubuntu/bruteforce-lab/.venv/bin/daphne -b 127.0.0.1 -p 8000 config.asgi:application
Restart=on-failure
RestartSec=3

# Basic hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
